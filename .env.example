# Nexora Video AI provider configuration
# Add real values only in the hosting provider's encrypted environment settings.

# Optional upload origin restriction (comma-separated origins)
ALLOWED_ORIGIN=

# AssemblyAI transcription
ASSEMBLYAI_API_KEY=

# ElevenLabs TTS
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_ADAM_VOICE_ID=
ELEVENLABS_EMMA_VOICE_ID=
ELEVENLABS_KHMER_MALE_VOICE_ID=
ELEVENLABS_KHMER_FEMALE_VOICE_ID=
ELEVENLABS_MULTI_MALE_VOICE_ID=
ELEVENLABS_MULTI_FEMALE_VOICE_ID=

# Vercel Blob for phone-video uploads and generated audio
BLOB_READ_WRITE_TOKEN=

# Translation provider adapter
TRANSLATION_API_URL=
TRANSLATION_API_KEY=

# Final MP4 renderer adapter
RENDER_API_URL=
# Optional: exact status endpoint, supports {id} placeholder.
# Example: https://renderer.example.com/jobs/{id}
RENDER_STATUS_API_URL=
RENDER_API_KEY=
