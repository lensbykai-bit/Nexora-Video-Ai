{
  "name": "nexora-dub-ai-windows-v3",
  "version": "3.1.0",
  "private": true,
  "description": "Nexora Dub.Ai Plus Windows desktop studio",
  "author": "Nexora",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build:win:clean": "electron-builder --win dir --x64"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ai.nexora.dub.windows",
    "productName": "Nexora Dub.Ai Plus",
    "copyright": "Copyright © 2026 Nexora",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": ["dir"],
      "requestedExecutionLevel": "asInvoker"
    }
  }
}
